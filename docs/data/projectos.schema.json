{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nzongo-pedro.github.io/NzongoPedro/data/projectos.schema.json",
  "title": "Portfólio de projectos",
  "description": "Catálogo de projectos para apresentar a clientes. Preencha links e capturas reais quando existirem; use null se não houver.",
  "type": "object",
  "required": ["meta", "projectos"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["titulo", "actualizadoEm", "idioma"],
      "properties": {
        "titulo": { "type": "string" },
        "actualizadoEm": { "type": "string", "format": "date" },
        "idioma": { "type": "string" },
        "notas": { "type": "string" }
      }
    },
    "projectos": {
      "type": "array",
      "items": { "$ref": "#/$defs/projecto" }
    }
  },
  "$defs": {
    "urlOuNulo": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "format": "uri" }
      ]
    },
    "imagem": {
      "type": "object",
      "required": ["ficheiro", "alt"],
      "additionalProperties": false,
      "properties": {
        "ficheiro": {
          "type": "string",
          "description": "Caminho relativo a docs/ (ex.: assets/projetos/amgolar/capa.webp)"
        },
        "alt": { "type": "string" },
        "legenda": { "type": "string" }
      }
    },
    "projecto": {
      "type": "object",
      "required": [
        "id",
        "nome",
        "tipo",
        "categoria",
        "estado",
        "descricao",
        "imagens"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Identificador estável, usado em pastas de imagens"
        },
        "nome": { "type": "string" },
        "subtitulo": {
          "type": "string",
          "description": "Frase curta para o cartão e para o cliente"
        },
        "tipo": {
          "type": "string",
          "enum": [
            "Aplicação web",
            "API",
            "Plataforma",
            "Infraestrutura de redes",
            "Mobile",
            "IoT",
            "Consultoria"
          ]
        },
        "categoria": {
          "type": "string",
          "description": "Sector de negócio (Imobiliário, Educação, GovTech, etc.)"
        },
        "estado": {
          "type": "string",
          "enum": [
            "em-producao",
            "codigo-aberto",
            "privado",
            "estudo-de-caso",
            "em-curso"
          ]
        },
        "destaque": { "type": "boolean" },
        "confidencial": {
          "type": "boolean",
          "description": "true se o código ou dados do cliente não podem ser públicos"
        },
        "ano": { "type": "integer", "minimum": 2015 },
        "duracao": { "type": "string" },
        "papel": { "type": "string" },
        "cliente": {
          "type": ["object", "null"],
          "properties": {
            "nome": { "type": ["string", "null"] },
            "sector": { "type": "string" },
            "localizacao": { "type": "string" }
          }
        },
        "descricao": { "type": "string" },
        "problema": {
          "type": "string",
          "description": "Dor do cliente, em linguagem de negócio"
        },
        "solucao": {
          "type": "string",
          "description": "O que foi construído e porquê"
        },
        "impacto": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Resultados mensuráveis ou qualitativos"
        },
        "funcionalidades": {
          "type": "array",
          "items": { "type": "string" }
        },
        "desafios": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Decisões técnicas que mostram profundidade"
        },
        "tecnologias": {
          "type": "array",
          "items": { "type": "string" }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "site": { "$ref": "#/$defs/urlOuNulo" },
            "github": { "$ref": "#/$defs/urlOuNulo" },
            "demo": { "$ref": "#/$defs/urlOuNulo" },
            "documentacao": { "$ref": "#/$defs/urlOuNulo" }
          }
        },
        "imagens": {
          "type": "object",
          "required": ["capa"],
          "additionalProperties": false,
          "properties": {
            "capa": { "$ref": "#/$defs/imagem" },
            "galeria": {
              "type": "array",
              "items": { "$ref": "#/$defs/imagem" }
            }
          }
        }
      }
    }
  }
}
